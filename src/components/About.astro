---
import { Image } from 'astro:assets';
import retrato from '../assets/img/retrato.jpg';
import content from '../data/content.json';
const { about } = content;
---
<section id="sobre-mi" class="section container" aria-labelledby="sobre-mi-heading" data-reveal>
  <p class="section__index">{about.sectionIndex}</p>
  <div class="about">
    <div class="about__portrait">
      <Image src={retrato} alt="Retrato de María José Farah" width={520} height={520} loading="eager" />
    </div>
    <div class="about__body">
      <h2 id="sobre-mi-heading">{about.heading}</h2>
      {about.paragraphs.map((p: string) => <p>{p}</p>)}
      <ul class="tags">
        {about.skills.map((skill: string) => <li class="tag">{skill}</li>)}
      </ul>
    </div>
  </div>
</section>
