---
import { Icon } from 'astro-icon/components';
import content from '../data/content.json';
const { contact, site } = content;
---
<section id="contacto" class="container contact-wrap" aria-labelledby="contacto-heading">
  <div class="contact" data-reveal>
    <p class="section__index section__index--onDark">{contact.sectionIndex}</p>
    <div class="contact__grid">
      <div>
        <h2 class="contact__title" id="contacto-heading">{contact.heading}</h2>
        {contact.paragraphs.map((p: string) => <p>{p}</p>)}
        <div class="actions">
          <a class="btn btn--accent" href={`mailto:${site.email}`}>
            <Icon name="lucide:mail" aria-hidden="true" width={16} height={16} />
            {site.email}
          </a>
          <a class="btn btn--outline-onDark" href={contact.resumeHref} target="_blank" rel="noopener">
            <Icon name="lucide:download" aria-hidden="true" width={16} height={16} />
            {contact.resumeCta}
          </a>
        </div>
      </div>
      <div class="contact__aside">
        <p class="contact__asideTitle">{contact.asideTitle}</p>
        <ul>
          {contact.asideItems.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>
