---
import { Image } from 'astro:assets';
import hero from '../assets/img/hero.jpg';
---
<section class="hero container">
  <div class="hero__copy">
    <h1 class="hero__title">Diseño y desarrollo de Mobiliario y Espacios</h1>
    <p class="lead">9 años de experiencia en el rubro de Diseño y decoración. Diseño líneas de productos, armo espacios a medida y acompaño cada proyecto desde la idea hasta la entrega.</p>
    <div class="actions">
      <a class="btn btn--primary" href="mailto:mariajosefarah.di@gmail.com">Escribime</a>
      <a class="btn btn--secondary" href="#proyectos">Ver proyectos</a>
    </div>
  </div>
  <figure class="bracketed">
    <Image
      class="media media--hero"
      src={hero}
      alt="Espacio exterior equipado con mobiliario de exterior"
      width={1020}
      height={840}
      widths={[520, 760, 1020]}
      sizes="(max-width: 760px) 100vw, 50vw"
    />
  </figure>
</section>
