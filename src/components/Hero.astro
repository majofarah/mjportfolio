---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import hero from '../assets/img/hero.jpg';
import content from '../data/content.json';
const { hero: heroContent, header, site } = content;
---
<section class="hero container">
  <div class="hero__copy">
    <h1 class="hero__title">{heroContent.title}</h1>
    <p class="lead">{heroContent.lead}</p>
    <div class="actions">
      <a class="btn btn--primary" href={`mailto:${site.email}`}>
        <Icon name="lucide:mail" aria-hidden="true" width={16} height={16} />
        {heroContent.ctaWrite}
      </a>
      <a class="btn btn--secondary" href="#proyectos">
        <Icon name="lucide:layout-grid" aria-hidden="true" width={16} height={16} />
        {header.nav.projects}
      </a>
    </div>
  </div>
  <figure class="bracketed">
    <Image
      class="media media--hero"
      src={hero}
      alt="Espacio exterior equipado con mobiliario de exterior"
      width={1020}
      height={840}
      widths={[520, 760, 1020]}
      sizes="(max-width: 760px) 100vw, 50vw"
      loading="eager"
    />
  </figure>
</section>
