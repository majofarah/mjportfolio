---
import { Icon } from 'astro-icon/components';
import type { DetailItem } from '../data/cases';
import content from '../data/content.json';

interface Props {
  kicker: string;
  title: string;
  description: string;
  detailList: DetailItem[];
  pdfHref: string;
}

const { kicker, title, description, detailList, pdfHref } = Astro.props;
const { pdfLinkLabel } = content.projects;
---
<div class="case__body">
  <p class="kicker">{kicker}</p>
  <h3>{title}</h3>
  <p>{description}</p>
  <ul class="detail-list">
    {detailList.map((item) => (
      <li>{item.label && <><strong>{item.label}:</strong>{' '}</>}{item.text}</li>
    ))}
  </ul>
  <a class="btn btn--secondary" href={pdfHref} target="_blank" rel="noopener">
    {pdfLinkLabel}
    <Icon name="lucide:external-link" aria-hidden="true" width={16} height={16} />
  </a>
</div>
