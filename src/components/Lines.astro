---
import { Image } from 'astro:assets';
import { lines } from '../data/lines';
import content from '../data/content.json';
const { lines: linesContent } = content;
---
<section id="lineas" class="section container" aria-labelledby="lineas-heading" data-reveal>
  <p class="section__index">{linesContent.sectionIndex}</p>
  <h2 id="lineas-heading">{linesContent.heading}</h2>
  <p class="section__intro">{linesContent.intro}</p>
  <ul class="lines">
    {lines.map((line) => (
      <li class="line">
        <Image
          class="media media--line"
          src={line.image}
          alt={`Línea ${line.name}`}
          width={718}
          height={520}
          widths={[359, 540, 718]}
          sizes="(max-width: 520px) 100vw, (max-width: 980px) 50vw, 33vw"
        />
        <p class="line__name">{line.name}</p>
        <p class="line__note">{line.note}</p>
      </li>
    ))}
  </ul>
</section>
